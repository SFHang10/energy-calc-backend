# Greenways optional LLM (Render Environment — do not commit real keys)

# --- Cortecs (recommended — JWT from HTMLS GWM GWB/Contl2 .txt) ---
# Docs: https://docs.cortecs.ai/api-overview/chat-completions.md
ASSISTANT_PROVIDER=cortecs
ASSISTANT_API_KEY=eyJ...paste-from-Contl2-txt
ASSISTANT_MODEL=anthropic/claude-3.5-sonnet
# Optional EU routing: pass preference via future agent payload; base URL default:
# ASSISTANT_API_BASE=https://api.cortecs.ai/v1

# --- OpenRouter fallback (sk-or-v1 key) ---
# ASSISTANT_PROVIDER=openrouter
# ASSISTANT_API_KEY=sk-or-v1-...
# ASSISTANT_MODEL=anthropic/claude-3.5-sonnet

# Optional — LLM polish on knowledge hits (launch mode). Default: finance,equipment
# GREENWAYS_AGENT_POLISH_AGENTS=finance,equipment
# Artemis pilot intents only (when equipment is in polish list):
# EQUIPMENT_AGENT_POLISH_INTENTS=deep_dive,why_equipment,insulation

OPENROUTER_HTTP_REFERER=https://energy-calc-backend.onrender.com
OPENROUTER_APP_TITLE=Greenways Agents

# Staff Agents Admin (demo password gate). Default if unset: Greenwaysadmin
# AGENTS_ADMIN_PASSWORD=Greenwaysadmin

# Live Music Finder guide — optional overrides (defaults to ASSISTANT_* above)
# MUSIC_GUIDE_PROVIDER=cortecs
# MUSIC_GUIDE_API_KEY=eyJ...
# MUSIC_GUIDE_MODEL=anthropic/claude-3.5-sonnet

# ENTSO-E — EU live grid + wholesale energy ticker (Vincent wire / /api/energy-ticker)
# One key is enough: site energy reading (NL/ES/PT) + native day-ahead prices (no Cloudflare worker required).
# Setup runbook: Skills/entsoe-setup.md · smoke: npm run smoke:entsoe
# 1) Register: https://transparency.entsoe.eu/
# 2) Email transparency@entsoe.eu — subject "Restful API access", body = your registered email
# 3) After approval (~3 working days): My Account → generate security token → Render ENTSOE_API_KEY
# ENTSOE_API_KEY=your-entsoe-security-token
# Optional legacy JSON proxy (overrides native ticker when both URL + key set):
# ENTSOE_PRICE_URL=https://...{API_KEY}...
# ENTSOE_RENEWABLE_URL=https://...{API_KEY}...
# Optional — adds EU 24h carbon forecast (https://electricitymaps.com/)
# ELECTRICITY_MAPS_API_KEY=your-electricity-maps-token

# Optional — UK EPC heating-fuel hint for Site energy reading connections
# Register: https://epc.opendatacommunities.org/ → API key (Basic auth email:key)
# When set, UK postcode lookup may attach connectionHint (hint only — user must Apply, then Save).
# EPC_OPEN_DATA_EMAIL=you@example.com
# EPC_OPEN_DATA_API_KEY=your-epc-api-key
# Aliases also accepted: EPC_API_EMAIL / EPC_API_KEY

# Vincent daily finance build cron (Render web service). Auto-enabled when RENDER is set.
# Override locally: GREENWAYS_FINANCE_DAILY_CRON_ENABLED=1
# Disable on Render: GREENWAYS_FINANCE_DAILY_CRON_ENABLED=0
# GREENWAYS_FINANCE_DAILY_CRON=0 6 * * *

# Agent wire refresh cron (Render web service). Auto-enabled when RENDER is set.
# Rebuilds deals-feed.json + greenways-agent-highlights.json for Zara wire and sidebar nudges.
# Override locally: GREENWAYS_WIRE_REFRESH_CRON_ENABLED=1
# Disable on Render: GREENWAYS_WIRE_REFRESH_CRON_ENABLED=0
# GREENWAYS_WIRE_REFRESH_CRON=0 5 * * 1

# Agent email — Wave 9 Email me this (Gmail / Google Workspace SMTP)
# Shared From: gwta@greenwaysrestaurants.com (Green Ways Transition Agents)
# 1) Enable 2-Step Verification on the Workspace account
# 2) Create an App password → paste below (never commit the real password)
# 3) On Render set AGENT_MAIL_SEND_ENABLED=1 after a staff test
# AGENT_MAIL_SMTP_USER=gwta@greenwaysrestaurants.com
# AGENT_MAIL_SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# AGENT_MAIL_SEND_ENABLED=0
# Optional pilot: only these To: addresses can receive (comma-separated)
# AGENT_MAIL_ALLOWLIST=you@example.com
# AGENT_MAIL_DAILY_LIMIT=20
# Optional aliases:
# GMAIL_USER=gwta@greenwaysrestaurants.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Agent voice — premium TTS (Wave 8 / talking phase). Browser fallback when unset.
# Recommended: SkillBoss only (same gateway as future agent email) — do not set ELEVENLABS_API_KEY unless A/B testing.
# SKILLBOSS_API_KEY=sk-...
# AGENT_VOICE_TTS_PROVIDER=skillboss
# Optional if Agent Sky changes host: SKILLBOSS_API_BASE=https://api.skillboss.co/v1
# Demo cast (useServerTts): Andrieus, Vincent, Zara, Artemis — data/greenways-agent-voice-config.json
# Verify: npm run smoke:agent-voice · GET /api/agent-voice/health
