{
  "updatedAt": "2026-07-15",
  "playbookSkill": "Skills/agents-data-refresh-playbook.md",
  "orchestratorTriggers": [
    "agents data refresh",
    "refresh agent data",
    "update agent databases",
    "data cleaning agents",
    "stale agent data",
    "rebuild deals feed",
    "refresh schemes",
    "run newsletter",
    "publish newsletter",
    "newsletter pipeline"
  ],
  "newsletterPlaybook": "Skills/newsletter-run-playbook.md",
  "staffLinks": {
    "agentsAdmin": "/agents-admin.html",
    "agentsAdminMap": "/agents-admin-map.html",
    "systemsAgent": "/greenways/systems-agent",
    "systemsStatusApi": "/api/systems-agent/status",
    "registry": "data/greenways-agent-admin-registry.json"
  },
  "tiers": [
    {
      "id": "canonical",
      "label": "Tier 1 — Canonical (edit here)",
      "paths": [
        "schemes.json",
        "FULL-DATABASE-5554.json",
        "data/sustainable-products-catalog.json",
        "data/deals-feed-seeds.json",
        "data/deals-weekly-input.json",
        "data/deals-source-registry.json",
        "data/deals-candidates.json",
        "data/greenways-content-modules.json",
        "data/companies.json"
      ]
    },
    {
      "id": "generated",
      "label": "Tier 2 — Generated (rebuild)",
      "paths": [
        "products-with-grants.json",
        "products-with-grants-and-collection.json",
        "data/deals-feed.json",
        "data/media-daily-brief.json",
        "data/finance-daily-external.json",
        "data/finance-news-rolling.json",
        "data/finance-daily-review.json",
        "data/finance-news-feed.json",
        "data/newsletter-looking-ahead-watchlist.json"
      ]
    }
  ],
  "newsletterPipeline": [
    {
      "id": "validate-editions",
      "label": "Validate review editions + Looking Ahead",
      "command": "npm run run:newsletter -- --validate"
    },
    {
      "id": "publish-newsletter",
      "label": "Full newsletter publish (agent feeds)",
      "command": "npm run run:newsletter -- --publish",
      "outputs": [
        "data/newsletter-looking-ahead-watchlist.json",
        "data/media-daily-brief.json",
        "data/finance-daily-external.json",
        "data/finance-news-rolling.json",
        "data/finance-daily-review.json",
        "data/finance-news-feed.json",
        "data/greenways-agent-highlights.json"
      ],
      "agents": ["media", "finance"]
    }
  ],
  "pipeline": [
    {
      "id": "integrator",
      "label": "Product grants export",
      "command": "node product-grants-integrator.js",
      "npmScript": null,
      "when": "schemes.json changed",
      "agents": ["grants", "equipment", "products", "finance"]
    },
    {
      "id": "build-products-grants-bundle",
      "label": "Grants + collection bundle",
      "command": "npm run build:products-grants-bundle",
      "npmScript": "build:products-grants-bundle",
      "when": "after product-grants-integrator.js (marketplace widget + deep dive)",
      "agents": ["grants", "equipment", "products", "finance", "systems"]
    },
    {
      "id": "enrich-sustainable",
      "label": "Sustainable catalog grants",
      "command": "npm run enrich:sustainable-products",
      "npmScript": "enrich:sustainable-products",
      "when": "sustainable-products-catalog.json or schemes changed",
      "agents": ["products"]
    },
    {
      "id": "build-deals-feed",
      "label": "Deals feed",
      "command": "npm run build:deals-feed",
      "npmScript": "build:deals-feed",
      "when": "deals seeds or weekly input changed",
      "agents": ["deals"]
    },
    {
      "id": "build-agent-highlights",
      "label": "Agent highlights (sidebar This week)",
      "command": "npm run build:agent-highlights",
      "npmScript": "build:agent-highlights",
      "when": "weekly — powers sidebar nudge on all seven agents",
      "agents": ["grants", "finance", "equipment", "deals", "media", "products", "systems"]
    },
    {
      "id": "build-media-brief",
      "label": "Media daily brief",
      "command": "npm run build:media-daily-brief",
      "npmScript": "build:media-daily-brief",
      "when": "new content-ops news edition",
      "agents": ["media"]
    },
    {
      "id": "build-finance-external-news",
      "label": "Vincent external RSS headlines",
      "command": "npm run build:finance-external-news",
      "npmScript": "build:finance-external-news",
      "when": "daily cron — EU/EIB RSS, UK DESNZ Atom, RVO/DBT staff queue, gov.uk finders",
      "agents": ["finance"]
    },
    {
      "id": "merge-finance-headlines",
      "label": "Promote approved finance headlines",
      "command": "npm run merge:finance-headlines",
      "npmScript": "merge:finance-headlines",
      "when": "after staff approve in finance-headlines-admin",
      "agents": ["finance"]
    },
    {
      "id": "build-finance-daily",
      "label": "Vincent full daily stack (RSS + review + feed)",
      "command": "npm run build:finance-daily",
      "npmScript": "build:finance-daily",
      "when": "daily cron on Render",
      "agents": ["finance"]
    },
    {
      "id": "build-finance-daily-review",
      "label": "Vincent daily price review",
      "command": "npm run build:finance-daily-review",
      "npmScript": "build:finance-daily-review",
      "when": "daily cron (or after media daily brief) — thin ticker + news skim for Finance wire / chat",
      "agents": ["finance"]
    },
    {
      "id": "run-newsletter",
      "label": "Newsletter publish (all agent news feeds)",
      "command": "npm run run:newsletter -- --publish",
      "npmScript": "run:newsletter",
      "when": "after content-ops monthly editions move to review/",
      "agents": ["media", "finance"]
    },
    {
      "id": "build-finance-news-feed",
      "label": "Vincent finance news roundup feed",
      "command": "npm run build:finance-news-feed",
      "npmScript": "build:finance-news-feed",
      "when": "after newsletter publish or edition HTML change",
      "agents": ["finance"]
    },
    {
      "id": "build-newsletter-watchlist",
      "label": "Looking Ahead carry-forward watchlist",
      "command": "npm run build:newsletter-watchlist",
      "npmScript": "build:newsletter-watchlist",
      "when": "before publish — checks prior Looking Ahead coverage",
      "agents": ["media", "finance"]
    },
    {
      "id": "sync-module-knowledge",
      "label": "Portal module → agent knowledge",
      "command": "npm run sync:content-module-knowledge:apply",
      "npmScript": "sync:content-module-knowledge:apply",
      "when": "greenways-content-modules.json changed",
      "agents": ["grants", "finance", "equipment", "deals", "media", "products", "systems"]
    },
    {
      "id": "sync-sidebar",
      "label": "Agent sidebar quick links",
      "command": "npm run sync:agent-sidebar",
      "npmScript": "sync:agent-sidebar",
      "when": "greenways-agent-sidebar-config.json changed",
      "agents": ["grants", "finance", "equipment", "deals", "media", "products", "systems"]
    }
  ],
  "validators": [
    {
      "id": "smoke-deals-feed",
      "label": "Deals feed v2 smoke",
      "command": "npm run smoke:deals-feed",
      "npmScript": "smoke:deals-feed"
    },
    {
      "id": "smoke-agents-ask",
      "label": "Agent knowledge smoke",
      "command": "npm run smoke:agents-ask",
      "npmScript": "smoke:agents-ask"
    },
    {
      "id": "smoke-agent-links",
      "label": "Agent reference link smoke",
      "command": "npm run smoke:agent-links",
      "npmScript": "smoke:agent-links"
    }
  ],
  "verify": {
    "label": "Edwardo read-only verify",
    "hint": "Open /greenways/systems-agent or GET /api/systems-agent/status — does not run scripts"
  }
}
