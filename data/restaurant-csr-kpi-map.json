{
  "updatedAt": "2026-08-05",
  "meta": {
    "title": "Restaurant CSR KPI map",
    "description": "22 hospitality CSR KPIs mapped to GRI disclosures and Greenways Transition Agent homes. Distilled from the Restaurant CSR Scorecard methodology — not a live Excel engine.",
    "version": "1",
    "sourceWorkbook": "Restaurant_CSR_Scorecard_Dashboard.xlsx (operator tool; do not embed in chat)",
    "methodology": "Skills/restaurant-csr-scorecard.md",
    "maturityScale": {
      "0": "None — not measured",
      "1": "Ad hoc — informal",
      "2": "Initial — early tracking",
      "3": "Established — systematic, partial data",
      "4": "Mature — actively managed with data",
      "5": "Best-in-class — verified / benchmarked"
    },
    "rag": {
      "green": "≥90% of target",
      "amber": "70–89% of target",
      "red": "<70% of target",
      "note": "For lowerIsBetter KPIs, compare target÷actual instead of actual÷target."
    },
    "defaultPillarWeights": {
      "environmental": 40,
      "ethical": 25,
      "philanthropic": 15,
      "economic": 20
    },
    "agentSlugs": {
      "andrieus": "grants-agent",
      "vincent": "finance-agent",
      "artemis": "equipment-agent",
      "zara": "deals-agent",
      "cheryce": "media-agent",
      "zyanne": "sustainable-products-agent",
      "edwardo": "systems-agent",
      "guide": "guide-agent"
    }
  },
  "pillars": [
    {
      "id": "environmental",
      "name": "Environmental",
      "defaultWeightPct": 40,
      "why": "Highest operational footprint and strongest regulatory pressure (energy, waste, water, CSRD-ready evidence).",
      "primaryAgent": "cheryce",
      "alsoAgents": ["edwardo", "vincent", "artemis", "zyanne", "andrieus", "guide"]
    },
    {
      "id": "ethical",
      "name": "Ethical",
      "defaultWeightPct": 25,
      "why": "Labour is the largest cost centre; acknowledge and hand off — Greenways does not own HR compliance.",
      "primaryAgent": "cheryce",
      "alsoAgents": ["guide"],
      "handoffNote": "Acknowledge living wage, safety, diversity; do not invent HR advice — suggest operator HR / legal."
    },
    {
      "id": "philanthropic",
      "name": "Philanthropic",
      "defaultWeightPct": 15,
      "why": "Community brand and food-donation hierarchy; secondary to regulatory pillars.",
      "primaryAgent": "cheryce",
      "alsoAgents": ["guide"],
      "handoffNote": "Local partnerships and volunteering — brand/community, not core product."
    },
    {
      "id": "economic",
      "name": "Economic",
      "defaultWeightPct": 20,
      "why": "Local / certified sourcing and supplier due diligence (CSDDD direction).",
      "primaryAgent": "zyanne",
      "alsoAgents": ["cheryce", "andrieus", "vincent", "guide"]
    }
  ],
